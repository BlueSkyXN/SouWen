# ===== SouWen 配置 =====
# 环境变量优先级最高（高于 souwen.yaml / ~/.config/souwen/config.yaml）
# 完整字段说明见 README.md 与 docs/configuration.md

# ===== 论文数据源 =====
# OpenAlex 是 Freemium API；超出免费额度是否使用预付余额取决于账户设置
SOUWEN_OPENALEX_API_KEY=
# 已弃用兼容字段；当前不发送给 OpenAlex
SOUWEN_OPENALEX_EMAIL=your@email.com
SOUWEN_SEMANTIC_SCHOLAR_API_KEY=
SOUWEN_PUBMED_API_KEY=

# ===== 专利数据源 =====
SOUWEN_PATENTSVIEW_API_KEY=
SOUWEN_USPTO_API_KEY=
SOUWEN_EPO_CONSUMER_KEY=
SOUWEN_EPO_CONSUMER_SECRET=


# ===== 网页搜索引擎 — 自建实例 =====
SOUWEN_SEARXNG_URL=http://localhost:8888
SOUWEN_WHOOGLE_URL=
SOUWEN_WEBSURFX_URL=

SOUWEN_REDDIT_CLIENT_ID=
SOUWEN_REDDIT_CLIENT_SECRET=

# ===== 开发者 / 视频 / Wiki =====
SOUWEN_GITHUB_TOKEN=
SOUWEN_STACKOVERFLOW_API_KEY=
SOUWEN_YOUTUBE_API_KEY=


# ===== 网页内容抓取（fetch 提供者）=====
# Provider v2 Fetch：builtin / jina_reader / wayback / deepwiki / API providers
SOUWEN_JINA_API_KEY=

# ===== 通用 =====
SOUWEN_PROXY=
# 多代理池（逗号分隔），优先于 SOUWEN_PROXY
SOUWEN_PROXY_POOL=
SOUWEN_TIMEOUT=30
SOUWEN_MAX_RETRIES=3
SOUWEN_DATA_DIR=~/.local/share/souwen
# 可选：覆盖 local catalog SQLite 路径；默认 <SOUWEN_DATA_DIR>/local_catalog.sqlite3
SOUWEN_LOCAL_CATALOG_PATH=
SOUWEN_MAX_CONCURRENCY=10
# auto | curl_cffi | httpx
SOUWEN_DEFAULT_HTTP_BACKEND=auto
# Search 有序默认表必须用完整 JSON object 覆盖 13 个 domain；推荐在 souwen.yaml 配置。
# 省略时使用内置表（paper primary 为 crossref）。
# SOUWEN_SEARCH_DEFAULTS={"web":["yahoo"],"news":["duckduckgo_news"],"paper":["huggingface","crossref","openalex"],"patent":[],"book":["open_library","internet_archive"],"code":["stackoverflow","github"],"community":["juejin","coolapk"],"wiki":["wikipedia"],"images":[],"videos":[]}
# LLM Search 共享 gateway（JSON）；Ark concrete sources remain disabled until enabled in sources YAML.
# SOUWEN_LLM_SEARCH_GATEWAYS={"uniapi":{"api_key":"","base_url":"https://gateway.example.com/v1"}}

# ===== 服务端 =====
SOUWEN_USER_PASSWORD=
# 允许无 Token 访问搜索端点（游客模式）
SOUWEN_GUEST_ENABLED=false
# 受信反向代理（逗号分隔的 IP/CIDR）
SOUWEN_TRUSTED_PROXIES=
# CORS 允许来源（逗号分隔）
SOUWEN_CORS_ORIGINS=
SOUWEN_EXPOSE_DOCS=true

# ===== WARP 代理（Docker 部署专用，可选）=====
SOUWEN_WARP_ENABLED=false
SOUWEN_WARP_MODE=auto
SOUWEN_WARP_SOCKS_PORT=1080
SOUWEN_WARP_ENDPOINT=
